# Copy to .env for local development (or set these as Railway variables).
# Only DATABASE_URL, ANTHROPIC_API_KEY, DIP_API_KEY and ADMIN_EMAILS are
# needed for the site to publish articles; everything else is optional.

# Postgres. On Railway: reference the Postgres service, ${{Postgres.DATABASE_URL}}.
# Leave empty locally to use the embedded PGlite database in .data/pglite.
DATABASE_URL=

# Public address, used for links in emails. Railway's RAILWAY_PUBLIC_DOMAIN is
# picked up automatically if this is empty.
BASE_URL=

# Who may open /admin (comma-separated). They get admin rights on registration/login.
ADMIN_EMAILS=

# Claude writes the articles.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# Bundestag DIP API key: public key at https://dip.bundestag.de/über-dip/hilfe/api
# (rotated yearly), or request a personal one from the Parlamentsdokumentation.
DIP_API_KEY=

# Email via Resend (https://resend.com). Needed for address confirmation,
# password reset and the newsletter. The domain in MAIL_FROM must be verified there.
MAIL_API_KEY=
MAIL_FROM="Versprochen & Beschlossen <newsletter@example.org>"
MAIL_REPLY_TO=

# Optional: semantic search with Voyage embeddings on top of full-text search.
VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3.5

# Impressum (required for a public German website).
IMPRINT_NAME=
IMPRINT_ADDRESS="Musterstraße 1 | 12345 Berlin"
IMPRINT_EMAIL=

# Tuning (defaults shown)
# SITE_NAME="Versprochen & Beschlossen"
# DIP_LOOKBACK_DAYS=10        how far back each fetch looks
# ARTICLE_SETTLE_HOURS=12     wait until a sitting day's DIP data stops changing
# ARTICLE_EARLIEST_HOUR=6     no articles or emails before this hour (Berlin)
# ARTICLE_MAX_DECISIONS=8     decisions analysed in depth per article
# MAIL_MAX_AGE_DAYS=3         don't email articles about older sitting days
# SCHEDULER=off               disable the built-in clock (use GET /api/tick?secret=CRON_SECRET)
# CRON_SECRET=
