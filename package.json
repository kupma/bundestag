{
  "name": "bundestag",
  "version": "1.0.0",
  "private": true,
  "description": "Erklärt die Beschlüsse des Bundestags verständlich – ein Artikel pro Sitzungstag, eine Vorschau auf die nächsten Abstimmungen, mit Kommentaren und Newsletter.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --env-file=.env server.js",
    "test": "node --test test/*.test.js",
    "dip:probe": "node scripts/dip-probe.js",
    "agenda:probe": "node scripts/agenda-probe.js",
    "generate": "node scripts/generate.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
